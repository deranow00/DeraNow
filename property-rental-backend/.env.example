NODE_ENV=development
PORT=8000
MONGO_URI=mongodb://localhost:27017/property-rental
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_TTL_DAYS=14

# Comma-separated origins, no trailing slash
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Email delivery. If SMTP_HOST/SMTP_USER/SMTP_PASS are present, SMTP is used first.
# Brevo SMTP example:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-smtp-login
# SMTP_PASS=your-brevo-smtp-key
# SMTP_FROM=verified-sender@example.com
#
# Optional fallback when SMTP_* is not configured:
# BREVO_API_KEY=your-brevo-api-key

EMAIL_OTP_TTL_MINUTES=10
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=30
